{
  "name": "pim",
  "productName": "Pim",
  "version": "0.1.0",
  "description": "Pim: Notch-Island am oberen Bildschirmrand für Windows. Musiksteuerung, Zwischenablage, Steam-Downloads, Datei-Upload.",
  "main": "main.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/test.js",
    "dist": "electron-builder --win portable nsis --x64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "de.pim.island",
    "productName": "Pim",
    "files": ["main.js", "preload.js", "lib/**", "src/**", "assets/**"],
    "asarUnpack": ["lib/*.ps1"],
    "win": { "icon": "assets/icon.png" },
    "nsis": { "oneClick": true, "perMachine": false },
    "portable": { "artifactName": "Pim-${version}-portable.exe" },
    "directories": { "output": "dist" }
  }
}
